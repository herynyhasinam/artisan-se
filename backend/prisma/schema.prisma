generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum Role {
  USER     // cherche un artisan
  ARTISAN  // a une fiche (créée à l'inscription)
  // ADMIN sera ajouté en fin de projet (modération)
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artisan      Artisan? // une seule fiche, uniquement pour les comptes ARTISAN
}

model Artisan {
  id              Int      @id @default(autoincrement())
  name            String
  trade           String   // métier
  neighborhood    String   // quartier
  city            String
  phone           String
  description     String?
  recommendations Int      @default(0)

  userId          Int      @unique // un compte = une fiche
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trade])
  @@index([neighborhood])
}
